# Settings that aren't secret, read by every part of UnderCover. Keys, and any
# setting you want to change on your machine, go in .env, which wins over this file.
# Tests and the end-to-end run read only this file.

# The backend, and the address the agent and the dashboard reach it on
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
UNDERCOVER_API=http://127.0.0.1:8000
UNDERCOVER_DB=backend/undercover.db

# The dashboard
DASHBOARD_PORT=5173

# The end-to-end tests' own backend and dashboard
E2E_API_PORT=8001
E2E_API_URL=http://127.0.0.1:8001
E2E_DASHBOARD_PORT=5174
E2E_DASHBOARD_URL=http://localhost:5174
E2E_DB=e2e/undercover-e2e.db

# Model providers
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768

# The agent's model, as provider:model, one of those in models.toml
MODEL_NAME=openrouter:deepseek/deepseek-v4.1-flash
