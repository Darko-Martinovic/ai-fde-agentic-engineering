# Copy to .env at the repo's root and fill in. Everything else is in settings/.env.defaults, and any of it
# can be overridden here.
OPENROUTER_API_KEY=
# Only on free models, before seeding: the one model allowed
# MODEL_NAME=openrouter:openrouter/free
# Supabase's session pooler connection string. Without it the backend and the
# dashboard run on SQLite, and the agent doesn't start.
DATABASE_URL=
# Langfuse traces; without the keys nothing is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# The Supabase project handlers sign in through, its publishable key, and the
# handlers' password for browser checks (labs/week2day5.ipynb)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
HANDLER_PASSWORD=
