# Copy to .env at the repo's root and fill in. Everything else is in settings/.env.defaults, and any of it
# can be overridden here.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# MODEL_NAME=anthropic:claude-haiku-5-5
# Supabase's session pooler connection string. Without it the backend and the
# dashboard run on SQLite, and the agent doesn't start.
DATABASE_URL=
# Langfuse traces; without the keys nothing is sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
