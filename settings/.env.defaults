# Settings that aren't secret, read by every part of UnderCover. Keys, and any
# setting you want to change on your machine, go in .env, which wins over this file.
# Tests and the end-to-end run read only this file. A value can name another
# setting as ${NAME}, so each host and port is written once.

# The backend, and the address the agent and the dashboard reach it on. To serve
# on every interface (0.0.0.0), set UNDERCOVER_API to an address clients can dial.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
# Threads for the backend's requests, beyond every claim agent's at once: each
# waits on one for a database connection, and its route runs on another
BACKEND_THREADS=200
UNDERCOVER_API=http://${BACKEND_HOST}:${BACKEND_PORT}
UNDERCOVER_DB=backend/undercover.db
# With DATABASE_URL in .env (Supabase's session pooler), the records and the
# agent's saved progress are on Postgres, in this schema, and each process keeps
# at most this many connections. Supabase's free plan allows 15 clients in all
# through the session pooler; the backend and the agent's service take 8, and a
# claim worked from the command line 4 more. Without it, the backend uses the
# SQLite file in UNDERCOVER_DB.
DATABASE_SCHEMA=undercover
DATABASE_CONNECTIONS=4
# Seconds a request or a claim agent waits for one of those connections before
# it fails: under the agent's 30 second wait for the backend, so the backend
# never works on a request the agent has given up on
DATABASE_WAIT_SECONDS=25

# The agent's service, which works dispatches and picks a claim back up after a
# handler's review, and the most claim agents a dispatch may have at once
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
AGENT_RELOAD=true
UNDERCOVER_AGENT=http://${AGENT_HOST}:${AGENT_PORT}
MAX_AGENTS=25

# The dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=5173

# The end-to-end tests' own backend and dashboard
E2E_API_PORT=8001
E2E_API_URL=http://${BACKEND_HOST}:${E2E_API_PORT}
E2E_DASHBOARD_PORT=5174
E2E_DASHBOARD_URL=http://${DASHBOARD_HOST}:${E2E_DASHBOARD_PORT}
E2E_DB=e2e/undercover-e2e.db
# A stand-in for the agent's service, so the end-to-end tests never reach the one
# npm run dev starts
E2E_AGENT_PORT=8003
E2E_AGENT_URL=http://${AGENT_HOST}:${E2E_AGENT_PORT}
# A stand-in for Supabase Auth, which signs the handlers in with this password,
# so the end-to-end tests never reach Supabase. Handlers sign in through the
# project in VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY, in .env.
E2E_AUTH_PORT=8004
E2E_AUTH_URL=http://${AGENT_HOST}:${E2E_AUTH_PORT}
E2E_HANDLER_PASSWORD=e2e-password
E2E_PUBLISHABLE_KEY=e2e-publishable-key
# A stand-in for the judge, which gives every claim the same grade
E2E_JUDGE_PORT=8005
E2E_JUDGE_URL=http://${AGENT_HOST}:${E2E_JUDGE_PORT}

# Model providers
OPENROUTER_URL=https://openrouter.ai
OPENROUTER_BASE_URL=${OPENROUTER_URL}/api/v1
# The judge, Jev, on OpenRouter's Decisions endpoint, in alpha: an origin, to which
# the openrouter package adds its path
JUDGE_URL=${OPENROUTER_URL}
JUDGE_MODEL=typesafe/jev-1.13
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
# Seconds a model call may take before it fails and is retried
MODEL_TIMEOUT=180
# The improver, which proposes changes to the claim agent in a round of
# improvement: one of the models allowed in data/models.json, at this reasoning
# effort. With MODEL_NAME set, it runs on that model instead.
IMPROVER_MODEL=openai/gpt-6-luna
IMPROVER_REASONING_EFFORT=medium

# Langfuse, where the agent's traces go, and the environment they're filed under.
# Its keys, LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY, go in .env
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# The claim agent's model comes from the current version of its configuration,
# one of the models allowed in data/models.json. A student on free models sets
# MODEL_NAME in .env, as provider:model, such as openrouter:openrouter/free or
# ollama:qwen3.5:4b, before seeding: it's then the only model allowed.
