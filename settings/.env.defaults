# Settings that aren't secret, read by every part of UnderCover. Keys, and any
# setting you want to change on your machine, go in .env, which wins over this file.
# Tests and the end-to-end run read only this file. A value can name another
# setting as ${NAME}, so each host and port is written once.

# The backend, and the address the agent and the dashboard reach it on. To serve
# on every interface (0.0.0.0), set UNDERCOVER_API to an address clients can dial.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
UNDERCOVER_API=http://${BACKEND_HOST}:${BACKEND_PORT}
UNDERCOVER_DB=backend/undercover.db
# With DATABASE_URL in .env (Supabase's session pooler), the records and the
# agent's saved progress are on Postgres, in this schema, and each process keeps
# at most this many connections. Supabase's free plan allows 15 clients in all
# through the session pooler; the backend, the agent's service and a run take 9.
# Without it, the backend uses the SQLite file in UNDERCOVER_DB.
DATABASE_SCHEMA=undercover
DATABASE_CONNECTIONS=3

# The agent's service, which the backend asks to pick a claim back up after a
# handler's review
AGENT_HOST=127.0.0.1
AGENT_PORT=8002
AGENT_RELOAD=true
UNDERCOVER_AGENT=http://${AGENT_HOST}:${AGENT_PORT}

# The dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=5173

# The end-to-end tests' own backend and dashboard
E2E_API_PORT=8001
E2E_API_URL=http://${BACKEND_HOST}:${E2E_API_PORT}
E2E_DASHBOARD_PORT=5174
E2E_DASHBOARD_URL=http://${DASHBOARD_HOST}:${E2E_DASHBOARD_PORT}
E2E_DB=e2e/undercover-e2e.db
# A stand-in for the agent's service, so the end-to-end tests never reach the one
# npm run dev starts
E2E_AGENT_PORT=8003
E2E_AGENT_URL=http://${AGENT_HOST}:${E2E_AGENT_PORT}

# Model providers
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=32768
# Seconds a model call may take before it fails and is retried
MODEL_TIMEOUT=180

# Langfuse, where the agent's traces go, and the environment they're filed under.
# Its keys, LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY, go in .env
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# The most the model comparison (uv run -m bench) may spend, in US dollars
BENCH_BUDGET_USD=10

# The agent's model, as provider:model, one of those in models.toml
MODEL_NAME=openrouter:deepseek/deepseek-v4.1-flash
