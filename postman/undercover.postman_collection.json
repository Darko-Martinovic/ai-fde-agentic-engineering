    {
      "name": "Agent",
      "description": "Starts and stops the UnderCover Agent. Run CLM-1003 calls the model for a moment before Stop ends it.",
      "item": [
        {
          "name": "Get agent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/agent",
              "host": [
