{
  "info": {
    "name": "UnderCover API",
    "description": "The UnderCover backend's API. Pick the UnderCover local environment, start the backend with `npm run dev`, then send a request or run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "`health`: check that the backend is running."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "List claims",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ]
            },
            "description": "`list_claims`: the queue with the state of each claim."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const claims = pm.response.json();",
                  "pm.test(\"25 claims\", () => pm.expect(claims).to.have.lengthOf(25));",
                  "pm.test(\"first claim is CLM-1001 for Maya Patel\", () => {",
                  "    pm.expect(claims[0].claim_id).to.eql(\"CLM-1001\");",
                  "    pm.expect(claims[0].customer_name).to.eql(\"Maya Patel\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get claim",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "{{claimId}}"
              ]
            },
            "description": "`get_claim`: one claim in full, with the story, items and documents."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const claim = pm.response.json();",
                  "pm.test(\"claim id matches\", () => pm.expect(claim.claim_id).to.eql(pm.environment.get(\"claimId\")));",
                  "pm.test(\"has items and documents\", () => {",
                  "    pm.expect(claim.items).to.be.an(\"array\").that.is.not.empty;",
                  "    pm.expect(claim.documents).to.be.an(\"array\").that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get claim, unknown",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/claims/CLM-9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims",
                "CLM-9999"
              ]
            },
            "description": "An unknown claim returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"says not found\", () => pm.expect(pm.response.json().detail).to.eql(\"Claim CLM-9999 not found\"));"
                ]
              }
            }
          ]
        }
      ]
    },
